model {

  ############
  # CONSTANTS
  ############
  # Define identity matrix I2 for bivariate standard normals z ~ N(0, I)
  # Define zero vector for mean-zero innovations
  # Define small eps floor for numerical stability

  I2[1,1] <- 1; I2[1,2] <- 0
  I2[2,1] <- 0; I2[2,2] <- 1
  zero[1] <- 0; zero[2] <- 0
  eps <- 1.0E-6

  ############################
  # 1) PERSON-LEVEL DYNAMICS #
  ############################
  # For each person i:
  #   - The first latent state eta[i,1,] is drawn from a population-level mean mu0 with precision tau_sigma0
  #   - At each time t > 1, the expected latent state mu_eta is given by an intercept alpha[i,] plus a VAR(1) term from beta[i,,] × previous eta
  #   - Evolution is non-centered: latent state = mean + L_psi × standard-normal innovations z
  #   - Observed y is drawn from eta with measurement precision theta_tau
  #   - Alpha and beta are person-specific random effects drawn from multivariate normals
  #
  # alpha[i,] ~ MVN(alpha_mu, alpha_tau^{-1})
  # beta[i,,] from beta_vec[i,] ~ MVN(beta_mu_vec, beta_tau^{-1})

  for (i in 1:N) {

    # Initial latent state: eta[i,1,] ~ N(mu0, tau_sigma0^{-1})
    eta[i, 1, 1:2] ~ dmnorm(mu0[], tau_sigma0[,])

    # State evolution and mean construction
    for (t in 2:M) {
      mu_eta[i, t, 1] <- alpha[i, 1] + inprod(beta[i, 1, 1:2], eta[i, t - 1, 1:2])
      mu_eta[i, t, 2] <- alpha[i, 2] + inprod(beta[i, 2, 1:2], eta[i, t - 1, 1:2])

      # Non-centered evolution: eta_t = mu_eta + L_psi %*% z_t, with z_t ~ N(0, I)
      z[i, t, 1:2] ~ dmnorm(zero[], I2[,])
      eta[i, t, 1] <- mu_eta[i, t, 1] + L_psi[1,1] * z[i, t, 1]  # L_psi[1,2] = 0
      eta[i, t, 2] <- mu_eta[i, t, 2] + L_psi[2,1] * z[i, t, 1] + L_psi[2,2] * z[i, t, 2]

      # Measurement model: fully observed bivariate outcome
      y[i, t, 1:2] ~ dmnorm(eta[i, t, 1:2], theta_tau[,])
    }

    # Random effects
    alpha[i, 1:2] ~ dmnorm(alpha_mu[], alpha_tau[,])

    beta_vec[i, 1:4] ~ dmnorm(beta_mu_vec[], beta_tau[,])
    beta[i, 1, 1] <- beta_vec[i, 1]
    beta[i, 1, 2] <- beta_vec[i, 2]
    beta[i, 2, 1] <- beta_vec[i, 3]
    beta[i, 2, 2] <- beta_vec[i, 4]
  }

  ##################################
  # 2) POPULATION-LEVEL HYPERPRIORS
  ##################################

  # Alpha_mu priors: diffuse normal with sd = 10
  # Beta_mu priors: tighter normal with sd = 0.5 to encourage stationarity of VAR(1)
  #   - sd = 0.5 keeps ≈86% of prior mass inside the stationary region
  # Wishart priors for precision matrices alpha_tau (df=3) and beta_tau (df=5) with modest scale matrices r_alpha, r_beta

  for (k in 1:2) {
    alpha_mu[k] ~ dnorm(0, 1/10^2)          # intercepts diffuse (sd = 10)
    for (j in 1:2) {
      beta_mu[k, j] ~ dnorm(0, 1/0.5^2)     # sd = 0.5 encourages stationarity
    }
  }
  beta_mu_vec[1] <- beta_mu[1,1]
  beta_mu_vec[2] <- beta_mu[1,2]
  beta_mu_vec[3] <- beta_mu[2,1]
  beta_mu_vec[4] <- beta_mu[2,2]

  # Wisharts for random-effect precisions (keep modest scale)
  alpha_tau[1:2,1:2] ~ dwish(r_alpha[,], 2 + 1)
  beta_tau[1:4,1:4]  ~ dwish(r_beta[,],  4 + 1)

  # #########################################################
  # 3) σ–ρ PARAMETERIZATION FOR ψ (STATE NOISE) AND θ (MEAS)
  # #########################################################
  # Both ψ (state noise) and θ (measurement noise) are pooled across persons.
  # Parameterization:
  #   - log standard deviations log_tau_* ~ Normal(0, 1.5²)
  #   - standard deviations tau_* = exp(log_tau_*) floored at eps
  #   - correlations via Fisher-z prior zrho_* ~ Normal(0, 1.0²), transformed with scaled logit to keep |rho| < 1
  #
  # For ψ:
  #   - Build covariance Σ_psi from tau_psi and rho_psi
  #   - Compute lower-triangular Cholesky L_psi
  #   - Compute L_psi^{-1} manually for stability
  #   - Compute precision psi_tau = (L^{-1})'(L^{-1})
  #   - L_psi used in non-centering of state evolution
  #
  # For θ:
  #   - Build covariance Σ_theta from tau_th and rho_th
  #   - Compute lower-triangular Cholesky L_th
  #   - Compute L_th^{-1} manually
  #   - Compute precision theta_tau = (L^{-1})'(L^{-1})
  #   - Used in measurement model y ~ MVN(eta, theta_tau)

  # ----- ψ (state noise; pooled, Cholesky → precision) -----
  for (k in 1:2) {
    log_tau_psi[k] ~ dnorm(0, 1 / pow(1.5, 2))
    tau_psi_raw[k] <- exp(log_tau_psi[k])
    tau_psi[k] <- tau_psi_raw[k] + 1.0E-6   # tiny floor for stability
  }
  zrho_psi ~ dnorm(0, 1 / pow(1.0, 2))
  rho_psi <- (2 * ilogit(zrho_psi) - 1) * (1 - eps)

  # Covariance entries (kept for monitoring)
  Sigma_psi[1,1] <- pow(tau_psi[1], 2)
  Sigma_psi[2,2] <- pow(tau_psi[2], 2)
  Sigma_psi[1,2] <- rho_psi * tau_psi[1] * tau_psi[2]
  Sigma_psi[2,1] <- Sigma_psi[1,2]

  # Cholesky of Σ_psi (lower-triangular) — you already use this for non-centering
  L_psi[1,1] <- tau_psi[1]
  L_psi[1,2] <- 0
  L_psi[2,1] <- rho_psi * tau_psi[2]
  L_psi[2,2] <- tau_psi[2] * sqrt(1 - pow(rho_psi, 2))

  # Inverse of lower-triangular L_psi:
  # If L = [[a, 0],[b, c]], then L^{-1} = [[1/a, 0],[-b/(a c), 1/c]]
  ap <- L_psi[1,1]
  bp <- L_psi[2,1]
  cp <- L_psi[2,2]
  Lap11 <- 1 / ap
  Lap12 <- 0
  Lap21 <- - bp / (ap * cp)
  Lap22 <- 1 / cp

  # Precision ψ_τ = (L^{-1})' (L^{-1})  (symmetric by construction)
  psi_tau[1,1] <- pow(Lap11, 2) + pow(Lap21, 2)
  psi_tau[1,2] <- Lap11 * Lap12 + Lap21 * Lap22   # = Lap21 * Lap22
  psi_tau[2,1] <- psi_tau[1,2]
  psi_tau[2,2] <- pow(Lap12, 2) + pow(Lap22, 2)   # = pow(Lap22, 2)

  # ----- θ (measurement noise; pooled, Cholesky → precision) -----
  for (k in 1:2) {
    log_tau_th[k] ~ dnorm(0, 1 / pow(1.5, 2))
    tau_th_raw[k] <- exp(log_tau_th[k])
    tau_th[k] <- tau_th_raw[k] + 1.0E-6   # tiny floor for numerical stability
  }
  zrho_th ~ dnorm(0, 1 / pow(1.0, 2))
  rho_th <- (2 * ilogit(zrho_th) - 1) * (1 - eps)  # keep |rho| < 1

  # Covariance entries (kept for monitoring)
  Sigma_theta[1,1] <- pow(tau_th[1], 2)
  Sigma_theta[2,2] <- pow(tau_th[2], 2)
  Sigma_theta[1,2] <- rho_th * tau_th[1] * tau_th[2]
  Sigma_theta[2,1] <- Sigma_theta[1,2]

  # Cholesky of Σ_theta (lower-triangular)
  L_th[1,1] <- tau_th[1]
  L_th[1,2] <- 0
  L_th[2,1] <- rho_th * tau_th[2]
  L_th[2,2] <- tau_th[2] * sqrt(1 - pow(rho_th, 2))

  # Inverse of lower-triangular L_th:
  # If L = [[a, 0],[b, c]], then L^{-1} = [[1/a, 0],[-b/(a c), 1/c]]
  a <- L_th[1,1]
  b <- L_th[2,1]
  c <- L_th[2,2]
  La11 <- 1 / a
  La12 <- 0
  La21 <- - b / (a * c)
  La22 <- 1 / c

  # Precision θ_τ = (L^{-1})' (L^{-1})  (symmetric by construction)
  theta_tau[1,1] <- pow(La11, 2) + pow(La21, 2)
  theta_tau[1,2] <- La11 * La12 + La21 * La22     # = La21 * La22
  theta_tau[2,1] <- theta_tau[1,2]
  theta_tau[2,2] <- pow(La12, 2) + pow(La22, 2)   # = pow(La22, 2)

  ##############################################
  # 4) MONITORS (OPTIONAL: save covariances too)
  ##############################################
  # alpha_sigma = inverse(alpha_tau) : covariance of alpha random effects
  # beta_sigma  = inverse(beta_tau)  : covariance of beta random effects
  # psi         = Σ_psi : state noise covariance
  # theta       = Σ_theta : measurement noise covariance
  
  alpha_sigma[1:2,1:2] <- inverse(alpha_tau[,])
  beta_sigma[1:4,1:4]  <- inverse(beta_tau[,])

  psi[1:2,1:2]   <- Sigma_psi
  theta[1:2,1:2] <- Sigma_theta
}
