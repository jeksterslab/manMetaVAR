	\caption{Conceptual Model of Affective Dynamics Predicting Adolescent Outcomes}
	\includegraphics[scale = 0.70]{.setup/latex/figures/pdf/empirical-model.pdf}
	\label{fig:manMetaVAR-empirical-model}
\end{sidewaysfigure*}

\subsection{Research Questions and Hypotheses}

Building on prior theory and empirical findings on affective dynamics and adolescent development, we pose the following research questions (RQs) and hypotheses (Hs) to guide the current investigation.

\subsubsection{RQ1: Characterizing and Decomposing Affective Dynamics}

\begin{itemize}
  \item \textbf{RQ1a.} What are the typical within-person dynamics of positive affect (PA) and negative affect (NA) in adolescents, as captured by autoregressive (AR), cross-regressive (CR), and attractor parameters? 
  \item \textbf{RQ1b.} To what extent do these within-person affective dynamics vary across individuals (i.e., between-person variability in AR, CR, and attractor parameters)?
  \item \textbf{RQ1c.} How strongly are the within-person dynamic parameters correlated at the between-person level (e.g., do adolescents with higher NA inertia also show weaker PA$\to$NA recovery)?
\end{itemize}

\noindent
\textbf{H1.} On average, adolescents will exhibit moderate positive autoregression (emotional inertia) for both PA and NA, negative cross-regression (PA$\to$NA), and emotional attractors centered near affective balance. However, substantial between-person variability is expected in all dynamic parameters, reflecting individual differences in emotion regulation capacity. Specifically, adolescents who recover more slowly from distress (higher AR[NA]) are expected to exhibit weaker PA$\to$NA coupling and higher NA attractors, indicating more dysphoric equilibrium states.

\subsubsection{RQ2: Family Processes and Affective Dynamics}

\begin{itemize}
  \item \textbf{RQ2a.} Does parental monitoring predict individual differences in the persistence and coupling of affective states?
  \item \textbf{RQ2b.} Does parent--child communication predict individual differences in affective attractors and cross-affective recovery?
\end{itemize}

\noindent
\textbf{H2.1.} Higher parental monitoring will be associated with lower AR(NA) (faster recovery from distress), stronger negative PA$\to$NA coupling (effective emotional dampening), and higher PA attractors (more positive equilibrium). \\
\noindent
\textbf{H2.2.} Poor monitoring and communication will predict higher NA inertia and higher NA attractors, reflecting chronic dysphoria and stress vulnerability. \\
\noindent
\textbf{H2.3.} Supportive communication will predict higher AR(PA) (sustained positive emotion) and more adaptive cross-affective coupling (greater emotional flexibility).

\subsubsection{RQ3: Affective Dynamics as Mediators of Family Effects on Substance Use}

\begin{itemize}
  \item \textbf{RQ3a.} Do adolescents from high-monitoring and high-communication families exhibit affective dynamics that buffer against later substance use?
  \item \textbf{RQ3b.} Do adolescents from low-monitoring and low-communication families exhibit maladaptive affective dynamics that increase risk for substance use?
\end{itemize}

\noindent
\textbf{H3.1.} Adaptive affective dynamics (low NA inertia, strong PA$\to$NA dampening, high PA attractor) will mediate the protective effects of parental monitoring and communication on later substance use. \\
\noindent
\textbf{H3.2.} Maladaptive affective dynamics (high NA inertia, weak PA$\to$NA coupling, high NA attractor) will mediate the risk-enhancing effects of poor family processes on later substance use.

