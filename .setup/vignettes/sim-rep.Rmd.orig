```{r}
#| message = FALSE
library(OpenMx)
library(fitVARMxID)
library(metaDyn)
library(manMetaVAR)
```

```{r}
#| include = FALSE
root <- rprojroot::is_rstudio_project
data_raw <- root$find_file(
  ".setup",
  "data-raw"
)
if (!dir.exists(data_raw)) {
  dir.create(data_raw, recursive = TRUE)
}
```

```{r}
#| include = FALSE
fn_data <- root$find_file(
  ".setup",
  "data-raw",
  "sim-rep-data.Rds"
)
if (!file.exists(fn_data)) {
  taskid <- 10
  seed <- 42
  set.seed(seed)
  data <- GenData(
    taskid = taskid,
    seed = seed
  )
  con <- xzfile(
    description = fn_data,
    compression = 9L
  )
  saveRDS(
    object = data,
    file = con
  )
  close(con)
}
data <- readRDS(fn_data)
```

```{r}
#| include = FALSE
fn_dtvar <- root$find_file(
  ".setup",
  "data-raw",
  "sim-rep-dtvar.Rds"
)
if (!file.exists(fn_dtvar)) {
  dtvar <- FitDTVAR(
    data = data,
    seed = seed
  )
  con <- xzfile(
    description = fn_dtvar,
    compression = 9L
  )
  saveRDS(
    object = dtvar,
    file = con
  )
  close(con)
}
dtvar <- readRDS(fn_dtvar)
```

```{r}
#| include = FALSE
fn_metavar <- root$find_file(
  ".setup",
  "data-raw",
  "sim-rep-metavar.Rds"
)
if (!file.exists(fn_metavar)) {
  metavar <- FitMetaVAR(
    fit = dtvar,
    seed = seed
  )
  con <- xzfile(
    description = fn_metavar,
    compression = 9L
  )
  saveRDS(
    object = metavar,
    file = con
  )
  close(con)
}
metavar <- readRDS(fn_metavar)
```

```{r}
#| include = FALSE
fn_naive <- root$find_file(
  ".setup",
  "data-raw",
  "sim-rep-naive.Rds"
)
if (!file.exists(fn_naive)) {
  naive <- FitNaive(
    fit = dtvar
  )
  con <- xzfile(
    description = fn_naive,
    compression = 9L
  )
  saveRDS(
    object = naive,
    file = con
  )
  close(con)
}
naive <- readRDS(fn_naive)
```

```{r}
#| include = FALSE
fn_mplus <- root$find_file(
  ".setup",
  "data-raw",
  "sim-rep-mplus.Rds"
)
if (!file.exists(fn_mplus)) {
  mplus <- FitMplus(
    data = data,
    seed = seed
  )
  con <- xzfile(
    description = fn_mplus,
    compression = 9L
  )
  saveRDS(
    object = mplus,
    file = con
  )
  close(con)
}
mplus <- readRDS(fn_mplus)
```

## Data Generation

```{r}
#| eval = FALSE
taskid <- 10
seed <- 42
set.seed(seed)
data <- GenData(
  taskid = taskid,
  seed = seed
)
```

```{r}
plot(data)
summary(data)
```

## MetaVAR

```{r}
#| eval = FALSE
dtvar <- FitDTVAR(
  data = data,
  seed = seed
)
```

```{r}
summary(dtvar, means = TRUE)
```

```{r}
#| eval = FALSE
metavar <- FitMetaVAR(
  fit = dtvar,
  seed = seed
)
```

```{r}
summary(metavar)
```

## Mplus

```{r}
#| eval = FALSE
mplus <- FitMplus(
  data = data,
  seed = seed
)
```

```{r}
summary(mplus)
```

```{r}
coef(mplus)
```

```{r}
vcov(mplus)
```

### Posterior Distributions

```{r}
plot(mplus, what = "posterior")
```

### Trace Plots

```{r}
plot(mplus, what = "trace")
```

### Mplus Output

```{r}
#| echo = FALSE,
#| comment = NA,
#| size = "normalsize"
writeLines(
  text = mplus$output$output,
  con = "mplus.inp"
)
cat(
  paste(
    readLines(
      "mplus.inp"
    ),
    collapse = "\n"
  )
)
```

## Uncorrected Two-Stage Benchmark

```{r}
#| eval = FALSE
naive <- FitNaive(
  fit = dtvar
)
```

```{r}
summary(naive)
```

```{r, rm}
#| include = FALSE
rm(list = ls())
```
