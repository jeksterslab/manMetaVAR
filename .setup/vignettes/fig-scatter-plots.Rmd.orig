```{r}
#| include = FALSE
knitr::opts_chunk$set(
  collapse = TRUE,
  fig.path = "fig-vignettes-scatter-plots-",
  fig.cap = "",
  fig.width = 11,
  fig.height = 8,
  fig.retina = 2,
  dpi = 300,
  comment = "#>",
  dev = "ragg_png"
)
```

```{r}
#| message = FALSE
library(manMetaVAR)
```

```{r}
data(results, package = "manMetaVAR")
```

### Bias

#### Fixed Effects

##### Point Estimates

```{r, bias-fixed}
#| echo = FALSE,
#| cache = FALSE
FigBias(results, parameters = "fixed", x_lab_size = 9)
```

##### Standard Errors

```{r, bias-se-fixed}
#| echo = FALSE,
#| cache = FALSE
FigBiasSE(results, parameters = "fixed", x_lab_size = 9)
```

#### Random Effects

##### Point Estimates

```{r, bias-random}
#| echo = FALSE,
#| cache = FALSE
FigBias(results, parameters = "random", x_lab_size = 9)
```

##### Standard Errors

```{r, bias-se-random}
#| echo = FALSE,
#| cache = FALSE
FigBiasSE(results, parameters = "random", x_lab_size = 9)
```

