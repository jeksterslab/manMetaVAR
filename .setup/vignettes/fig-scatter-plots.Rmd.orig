```{r}
#| include = FALSE
knitr::opts_chunk$set(
  collapse = TRUE,
  fig.path = "fig-vignettes-scatter-plots-",
  fig.cap = "",
  fig.width = 11,
  fig.height = 8,
  fig.retina = 2,
  dpi = 300,
  comment = "#>",
  dev = "ragg_png"
)
```

```{r}
#| message = FALSE
library(manMetaVAR)
```

```{r}
data(results, package = "manMetaVAR")
```

### Bias

#### Fixed Effects

```{r, bias-fixed}
#| echo = FALSE,
#| cache = FALSE
FigBias(
  results,
  parameters = "fixed",
  ylim = c(-0.15, 0.10),
  x_lab_size = 10
)
```

#### Random Effects

```{r, bias-random}
#| echo = FALSE,
#| cache = FALSE
FigBias(
  results,
  parameters = "random",
  ylim = c(-0.4, 0.4),
  x_lab_size = 9
)
```

### RMSE

#### Fixed Effects

```{r, rmse-fixed}
#| echo = FALSE,
#| cache = FALSE
FigRMSE(
  results,
  parameters = "fixed",
  ylim = c(0.0, 0.15),
  x_lab_size = 10
)
```

#### Random Effects

```{r, rmse-random}
#| echo = FALSE,
#| cache = FALSE
FigRMSE(
  results,
  parameters = "random",
  ylim = c(0.0, 0.31),
  x_lab_size = 9
)
```

### Coverage Probabilities

#### Fixed Effects

```{r, coverage-fixed}
#| echo = FALSE,
#| cache = FALSE
FigCoverage(
  results,
  parameters = "fixed",
  ylim = c(0.50, 0.97),
  x_lab_size = 10
)
```

#### Random Effects

```{r, coverage-random}
#| echo = FALSE,
#| cache = FALSE
FigCoverage(
  results,
  parameters = "random",
  ylim = c(0.8, 0.97),
  x_lab_size = 9
)
```

### Statistical Power

#### Fixed Effects

```{r, power-fixed}
#| echo = FALSE,
#| cache = FALSE
FigPower(
  results,
  parameters = "fixed",
  ylim = c(0.20, 1.00),
  x_lab_size = 10
)
```

#### Random Effects

```{r, power-random}
#| echo = FALSE,
#| cache = FALSE
FigPower(
  results,
  parameters = "random",
  x_lab_size = 9
)
```

